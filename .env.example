# --- Med Assist backend ---
# When running the FastAPI backend locally:
#   uvicorn med_assist.api.main:app --port 8000
# Then point the React frontend at it via:
VITE_BACKEND_URL=http://localhost:8000

# --- Auth0 (optional for offline test; required for /chat /scanner /profile /cabinet) ---
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id

# --- Firebase (optional; used by HealthProfile + MedicineCabinet) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
